RAQBO_SESSION_SECRET=replace-with-a-random-secret-at-least-32-bytes
RAQBO_ADMIN_BOOTSTRAP_KEY=replace-with-a-separate-random-secret-at-least-32-bytes
RAQBO_DATABASE_PATH=C:\absolute\path\to\raqbo.sqlite
RAQBO_MEDIA_DIRECTORY=C:\absolute\path\to\raqbo-private-media
RAQBO_ALLOW_DEV_OTP=false
RAQBO_SEED_DEMO_DATA=false
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
